# ─── Bybit API Credentials ───────────────────────────────────────────────────
# Generate these at: https://testnet.bybit.com/app/user/api-management
# For live trading:  https://www.bybit.com/app/user/api-management

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# ─── Mode ─────────────────────────────────────────────────────────────────────
# true  → Testnet (safe, fake money)
# false → Live    (real money, be careful!)
BYBIT_TESTNET=true

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
